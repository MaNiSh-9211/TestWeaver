# Database Configuration
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
PGDATABASE=neondb
PGHOST=ep-purple-base-a88e7z4g-pooler.eastus2.azure.neon.tech
PGPORT=5432
PGUSER=neondb_owner
PGPASSWORD=CHANGE_ME_NEON_DB_PASSWORD

# Replit Authentication (Optional)
REPL_ID=your-repl-id
ISSUER_URL=https://replit.com/oidc
REPLIT_DOMAINS=your-domain.replit.dev
SESSION_SECRET=your-super-secret-session-key-here

# Groq AI Configuration
GROQ_API_KEY=CHANGE_ME_GROQ_API_KEY

# Application Configuration
NODE_ENV=development
PORT=7000

# File Storage (for screenshots and reports)
STORAGE_PATH=./storage

# Webhook Configuration
WEBHOOK_SECRET=your-webhook-secret-key

# External Integrations
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_USERNAME=your-jira-username
JIRA_API_TOKEN=your-jira-api-token

# GitHub Integration (Optional)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Google Integration (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs/testweaver.log

# Performance & Scaling
MAX_CONCURRENT_TESTS=5
TEST_TIMEOUT_MS=300000
BROWSER_POOL_SIZE=3

# Security
CORS_ORIGIN=http://localhost:5000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Feature Flags
ENABLE_SCREENSHOTS=true
ENABLE_VIDEO_RECORDING=false
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_AI_DEBUGGING=true

# Notification Configuration (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
EMAIL_SERVICE_API_KEY=your-email-service-api-key
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/DISCORD/WEBHOOK

# Monitoring & Analytics (Optional)
SENTRY_DSN=https://your-sentry-dsn
DATADOG_API_KEY=your-datadog-api-key
PROMETHEUS_PORT=9090

# Cache Configuration
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=3600

# AI Model Configuration
GROQ_MODEL=meta-llama/llama-3-70b-8192
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=2000
AI_TIMEOUT_MS=30000

# Browser Configuration
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage

# Test Execution Configuration
DEFAULT_VIEWPORT_WIDTH=1920
DEFAULT_VIEWPORT_HEIGHT=1080
DEFAULT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36

# Development Configuration
VITE_API_BASE_URL=http://localhost:5000
VITE_WS_URL=ws://localhost:5000/ws
VITE_APP_NAME=TestWeaver
VITE_APP_VERSION=1.0.0

# Production Configuration (for deployment)
PRODUCTION_URL=https://your-production-domain.com
CDN_URL=https://your-cdn-domain.com
BACKUP_STORAGE_URL=s3://your-backup-bucket

# Webhook Endpoints for Jira Configuration
# Add this URL to your Jira webhook configuration:
# https://your-domain.com/api/webhook/jira
#
# Required Jira Custom Fields:
# - customfield_10000: User Story (Text Field)
# - customfield_10001: Base URL (URL Field)  
# - customfield_10002: Credentials (JSON Field - optional)
#
# Webhook Events to Enable:
# - Issue Created
# - Issue Updated
